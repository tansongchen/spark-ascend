  int buf=phase%2,ev=4+buf,tile=phase_tile(phase,tiles),slot=tile%2;
  if(phase+1<2*tiles){int next=phase+1,nbuf=next%2,nev=4+nbuf,nt=phase_tile(next,tiles),off=nt*N;Mutex::Lock<PIPE_MTE2>(nev);
   if(phase_q(next,tiles))copy_pages(kv[nbuf*N*D],k,table,start+off,imin(N,valid-off),head);else copy_pages(kv[nbuf*N*D],v,table,start+off,imin(N,valid-off),head);Mutex::Unlock<PIPE_MTE2>(nev);
