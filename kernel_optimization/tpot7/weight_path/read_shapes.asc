#include "kernel_operator.h"
using namespace AscendC;
extern "C" __global__ __aicore__ void read_shapes(GM_ADDR src,GM_ADDR dst,uint32_t total,uint32_t tile,uint32_t cyclic,uint32_t cached,uint32_t full){
 KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
 TPipe pipe;TQueBind<TPosition::VECIN,TPosition::VECOUT,2> q;
 pipe.InitBuffer(q,2,tile*sizeof(uint32_t));
 GlobalTensor<uint32_t> input,output;input.SetGlobalBuffer((__gm__ uint32_t*)src,total);output.SetGlobalBuffer((__gm__ uint32_t*)dst);
 if(!cached)input.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);
 const uint32_t tiles=total/tile,core=GetBlockIdx(),cores=GetBlockNum();
 const uint32_t start=cyclic?core:tiles*core/cores,end=cyclic?tiles:tiles*(core+1)/cores,stride=cyclic?cores:1;
 if(start>=end)return;
 auto first=q.AllocTensor<uint32_t>();DataCopy(first,input[(uint64_t)start*tile],tile);q.EnQue(first);
 for(uint32_t i=start;i<end;i+=stride){
  if(i+stride<end){auto next=q.AllocTensor<uint32_t>();DataCopy(next,input[(uint64_t)(i+stride)*tile],tile);q.EnQue(next);}
  auto local=q.DeQue<uint32_t>();
  // full=1 verifies every byte using the same inbound transfer and queue order.
  // full=0 measures read-dominant access with only a 32-byte sample per tile.
  DataCopy(output[(uint64_t)i*(full?tile:8)],local,full?tile:8);
  q.FreeTensor(local);
 }
}
#ifndef __CCE_AICORE__
extern "C" void launch_read_shapes(void*s,uint8_t*x,uint8_t*y,uint32_t total,uint32_t tile,uint32_t cyclic,uint32_t cached,uint32_t full){
 read_shapes<<<56,nullptr,s>>>(x,y,total,tile,cyclic,cached,full);
}
#endif
