 // before the next stage recreates this same allocation without initialization.
 auto wb=weights.Get<bfloat16_t>();
 auto first=wb[first_slot*32768];
 if(!prefetched)DataCopy(first,b[(int64_t)(start/M)*WL],WL);
 SetFlag<HardEvent::MTE2_V>(4+first_slot);
 const int tiles=(end-start)/M;
 for(int i=0;i<tiles;i++){
  const int slot=(first_slot+i)&1,other=slot^1,row=start+i*M;
  // Reuse the inactive slot only after the preceding VF has finished reading it.
  if(i>0)WaitFlag<HardEvent::V_MTE2>(4+other);
  if(i+1<tiles){DataCopy(wb[other*32768],b[(int64_t)((row+M)/M)*WL],WL);SetFlag<HardEvent::MTE2_V>(4+other);}
  else if(next_wgm!=nullptr){
   GlobalTensor<bfloat16_t>nw;nw.SetGlobalBuffer((__gm__ bfloat16_t*)next_wgm);nw.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);
   constexpr int NK=2560,NM=8,NN=20480;
   const int next_start=((NN/NM)*logical/56)*NM;
   DataCopy(wb[other*32768],nw[(int64_t)(next_start/NM)*(NM*NK*3/4+528)],NM*NK*3/4+528);
  }
