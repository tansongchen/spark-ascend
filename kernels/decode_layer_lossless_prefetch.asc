}
__aicore__ inline void vec(TPipe &pipe,GM_ADDR pp,GM_ADDR yp,GM_ADDR lp,int width,int logical){
 int task=logical/2,part=task/4,head=task%4,sub=GetSubBlockIdx(),start=part*width;GlobalTensor<int64_t>pos;pos.SetGlobalBuffer((__gm__ int64_t*)pp);int valid=imin(width,imax(0,(int)pos.GetValue(0)+1-start));
