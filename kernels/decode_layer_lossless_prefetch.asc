__aicore__ inline void run(TPipe &pipe,GM_ADDR x,GM_ADDR res,GM_ADDR w1,GM_ADDR w2,GM_ADDR lut,GM_ADDR g1,GM_ADDR g2,GM_ADDR mid,GM_ADDR raw,GM_ADDR resmid,GM_ADDR y,GM_ADDR resout,float e1,float e2,int mode,int up_slot){
 
