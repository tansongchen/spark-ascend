}
__aicore__ inline bool phase_q(int phase,int tiles){return phase==0||((phase%2)==1&&phase<2*tiles-1);}
__aicore__ inline int phase_tile(int phase,int tiles){return phase_q(phase,tiles)?(phase==0?0:(phase+1)/2):(phase==2*tiles-1?tiles-1:phase/2-1);}
__aicore__ inline void cube(GM_ADDR qp,GM_ADDR kp,GM_ADDR vp,GM_ADDR tp,GM_ADDR pp,int width,int logical){
