#include "lossless_vf.h"
using namespace AscendC;
extern "C" __global__ __aicore__ void decode_tile(GM_ADDR src,GM_ADDR dst,uint32_t elements){
 KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
 TPipe pipe;TBuf<TPosition::VECCALC>input,output;
 const uint32_t stride=32+elements*3/2+LOSSLESS_REPAIRS*4;
 pipe.InitBuffer(input,stride+128);pipe.InitBuffer(output,elements*2);
 auto x=input.Get<uint8_t>();auto y=output.Get<uint16_t>();
 GlobalTensor<uint8_t>gm;GlobalTensor<uint16_t>out;gm.SetGlobalBuffer(src);out.SetGlobalBuffer((__gm__ uint16_t*)dst);
 DataCopy(x,gm,stride);SetFlag<HardEvent::MTE2_V>(0);WaitFlag<HardEvent::MTE2_V>(0);
 if(elements==20480)LosslessBF16::decode<20480>((__ubuf__ uint8_t*)x.GetPhyAddr(),(__ubuf__ uint16_t*)y.GetPhyAddr());
 else if(elements==40960)LosslessBF16::decode<40960>((__ubuf__ uint8_t*)x.GetPhyAddr(),(__ubuf__ uint16_t*)y.GetPhyAddr());
 SetFlag<HardEvent::V_MTE3>(0);WaitFlag<HardEvent::V_MTE3>(0);DataCopy(out,y,elements);
}
#ifndef __CCE_AICORE__
extern "C" void launch_decode_tile(void*stream,uint8_t*packed,uint8_t*out,uint32_t elements){decode_tile<<<1,nullptr,stream>>>(packed,out,elements);}
#endif
