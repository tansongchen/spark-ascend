/**
 * Spark-X2.5-4B BF16 无损权重编码融合 decode（lossless_fast 已验收版本）。
 *
 * 独立编译此文件，勿与 decode_layer_stage_prefetch.asc 同时链接：为了兼容
 * integration/spark_fused_decode.py，保留 launch_decode_layer_stage_prefetch ABI。
 * QKV / attention / O 使用原实现，复用同目录 Cube 与 sigmoid LUT 头文件。
 * 仅 a[4] / a[5]（MLP up / down）改用无损编码；传入原 BF16 权重布局不兼容。
 * CPU 打包器：kernel_optimization/tpot7/lossless/codec.py::pack_weight。
 * 固定 256 个修补项、指数 base=109；workspace=131072 bytes。
 * 适用 BF16、TP=PP=1、单请求、block=128、context<=40960、融合 eager。
 *
 * 构建：bash kernel_validation/build_lossless.sh <数据盘上的新输出目录>
 * .so 必须与构建生成的 execution.json 一起使用，manifest 选择正确的打包。
 * 完整合同与复现见 kernels/LOSSLESS_DECODE.md。
 *
 * 整理自已验证源码 SHA256：
 * 6271282dd4e0cb3d7d9faaa9f21b91d2fe2e8ea31e148b4e032f2c208d2728d4
 * 本文件仅增加说明并重命名本地解码头 include，保留全部计算与验证入口。
 */
#define LOSSLESS_REPAIRS 256
#include "decode_bf16_lossless_vf.h"
#include "kernel_operator.h"
#include "decode_cube_matmul.h"
#include "decode_sigmoid_lut_vf.h"
using namespace AscendC;
using namespace AscendC::Impl::Detail;
#ifndef __DAV_C310_CUBE__

#ifndef __DAV_C310_CUBE__
constexpr AscendC::SyncAllConfig kStageSync={PIPE_MTE3,PIPE_MTE2};
__aicore__ inline void stage_barrier(){
 // Chain consecutive barriers even on lanes that skip the merge stage.
 // Every producer writes through MTE3; the next consumer first loads through MTE2.
 AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(7);
 AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(7);
 AscendC::SyncAll<true,kStageSync>();
}
#endif
namespace QkvStage {
using namespace AscendC;
namespace R=AscendC::Reg;
constexpr R::CastTrait up{R::RegLayout::ZERO,R::SatMode::UNKNOWN,R::MaskMergeMode::ZEROING,RoundMode::UNKNOWN};
constexpr R::CastTrait down{R::RegLayout::ZERO,R::SatMode::NO_SAT,R::MaskMergeMode::ZEROING,RoundMode::CAST_RINT};
__simd_vf__ void expand_input(__ubuf__ bfloat16_t*x,__ubuf__ float*y,int k){
 auto p=R::CreateMask<float,R::MaskPattern::ALL>();R::RegTensor<bfloat16_t>b;R::RegTensor<float>f;
 for(uint16_t j=0;j<k/64;j++){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(b,x+j*64);R::Cast<float,bfloat16_t,up>(f,b,p);R::StoreAlign(y+j*64,f,p);}
 R::LocalMemBar<R::MemType::VEC_STORE,R::MemType::VEC_LOAD>();
}
template<int K,int M> __simd_vf__ void gemv(__ubuf__ float*x,__ubuf__ bfloat16_t*w,__ubuf__ float*tmp,__ubuf__ bfloat16_t*y){
 auto p=R::CreateMask<float,R::MaskPattern::ALL>();uint32_t one=1;auto p1=R::UpdateMask<float>(one);
 R::RegTensor<float>a,b,t;R::RegTensor<bfloat16_t>ab,bb;
 R::RegTensor<float>s0; if constexpr(M>0)R::Duplicate(s0,0.0f);
 R::RegTensor<float>s1; if constexpr(M>1)R::Duplicate(s1,0.0f);
 R::RegTensor<float>s2; if constexpr(M>2)R::Duplicate(s2,0.0f);
 R::RegTensor<float>s3; if constexpr(M>3)R::Duplicate(s3,0.0f);
 R::RegTensor<float>s4; if constexpr(M>4)R::Duplicate(s4,0.0f);
 R::RegTensor<float>s5; if constexpr(M>5)R::Duplicate(s5,0.0f);
 R::RegTensor<float>s6; if constexpr(M>6)R::Duplicate(s6,0.0f);
 R::RegTensor<float>s7; if constexpr(M>7)R::Duplicate(s7,0.0f);
 R::RegTensor<float>s8; if constexpr(M>8)R::Duplicate(s8,0.0f);
 R::RegTensor<float>s9; if constexpr(M>9)R::Duplicate(s9,0.0f);
 R::RegTensor<float>s10; if constexpr(M>10)R::Duplicate(s10,0.0f);
 R::RegTensor<float>s11; if constexpr(M>11)R::Duplicate(s11,0.0f);
 R::RegTensor<float>s12; if constexpr(M>12)R::Duplicate(s12,0.0f);
 R::RegTensor<float>s13; if constexpr(M>13)R::Duplicate(s13,0.0f);
 R::RegTensor<float>s14; if constexpr(M>14)R::Duplicate(s14,0.0f);
 R::RegTensor<float>s15; if constexpr(M>15)R::Duplicate(s15,0.0f);
 for(uint16_t j=0;j<K/64;j++){
  R::LoadAlign(a,x+j*64);
  if constexpr(M>0){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+0)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s0,a,b,p);}
  if constexpr(M>1){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+1)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s1,a,b,p);}
  if constexpr(M>2){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+2)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s2,a,b,p);}
  if constexpr(M>3){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+3)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s3,a,b,p);}
  if constexpr(M>4){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+4)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s4,a,b,p);}
  if constexpr(M>5){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+5)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s5,a,b,p);}
  if constexpr(M>6){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+6)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s6,a,b,p);}
  if constexpr(M>7){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+7)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s7,a,b,p);}
  if constexpr(M>8){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+8)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s8,a,b,p);}
  if constexpr(M>9){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+9)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s9,a,b,p);}
  if constexpr(M>10){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+10)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s10,a,b,p);}
  if constexpr(M>11){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+11)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s11,a,b,p);}
  if constexpr(M>12){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+12)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s12,a,b,p);}
  if constexpr(M>13){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+13)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s13,a,b,p);}
  if constexpr(M>14){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+14)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s14,a,b,p);}
  if constexpr(M>15){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(bb,w+(j*M+15)*64);R::Cast<float,bfloat16_t,up>(b,bb,p);R::MulAddDst(s15,a,b,p);}
 }
 if constexpr(M>0){R::Reduce<R::ReduceType::SUM>(s0,s0,p);R::StoreAlign(tmp+0*64,s0,p1);}
 if constexpr(M>1){R::Reduce<R::ReduceType::SUM>(s1,s1,p);R::StoreAlign(tmp+1*64,s1,p1);}
 if constexpr(M>2){R::Reduce<R::ReduceType::SUM>(s2,s2,p);R::StoreAlign(tmp+2*64,s2,p1);}
 if constexpr(M>3){R::Reduce<R::ReduceType::SUM>(s3,s3,p);R::StoreAlign(tmp+3*64,s3,p1);}
 if constexpr(M>4){R::Reduce<R::ReduceType::SUM>(s4,s4,p);R::StoreAlign(tmp+4*64,s4,p1);}
 if constexpr(M>5){R::Reduce<R::ReduceType::SUM>(s5,s5,p);R::StoreAlign(tmp+5*64,s5,p1);}
 if constexpr(M>6){R::Reduce<R::ReduceType::SUM>(s6,s6,p);R::StoreAlign(tmp+6*64,s6,p1);}
 if constexpr(M>7){R::Reduce<R::ReduceType::SUM>(s7,s7,p);R::StoreAlign(tmp+7*64,s7,p1);}
 if constexpr(M>8){R::Reduce<R::ReduceType::SUM>(s8,s8,p);R::StoreAlign(tmp+8*64,s8,p1);}
 if constexpr(M>9){R::Reduce<R::ReduceType::SUM>(s9,s9,p);R::StoreAlign(tmp+9*64,s9,p1);}
 if constexpr(M>10){R::Reduce<R::ReduceType::SUM>(s10,s10,p);R::StoreAlign(tmp+10*64,s10,p1);}
 if constexpr(M>11){R::Reduce<R::ReduceType::SUM>(s11,s11,p);R::StoreAlign(tmp+11*64,s11,p1);}
 if constexpr(M>12){R::Reduce<R::ReduceType::SUM>(s12,s12,p);R::StoreAlign(tmp+12*64,s12,p1);}
 if constexpr(M>13){R::Reduce<R::ReduceType::SUM>(s13,s13,p);R::StoreAlign(tmp+13*64,s13,p1);}
 if constexpr(M>14){R::Reduce<R::ReduceType::SUM>(s14,s14,p);R::StoreAlign(tmp+14*64,s14,p1);}
 if constexpr(M>15){R::Reduce<R::ReduceType::SUM>(s15,s15,p);R::StoreAlign(tmp+15*64,s15,p1);}
 R::LocalMemBar<R::MemType::VEC_STORE,R::MemType::VEC_LOAD>();uint32_t count=M;auto pm=R::UpdateMask<float>(count);
 R::RegTensor<int32_t>ix;R::RegTensor<float>out;R::RegTensor<bfloat16_t>ob;R::Arange(ix,0);R::Muls(ix,ix,64,pm);R::Gather(out,tmp,(R::RegTensor<uint32_t>&)ix,pm);R::Cast<bfloat16_t,float,down>(ob,out,pm);R::StoreAlign<bfloat16_t,R::StoreDist::DIST_PACK_B32>(y,ob,pm);
}
__simd_vf__ void rope4(__ubuf__ bfloat16_t*y,__ubuf__ bfloat16_t*cs,int off,int half){
 R::LocalMemBar<R::MemType::VEC_STORE,R::MemType::VEC_LOAD>();uint32_t n=4;auto p=R::UpdateMask<float>(n);
 R::RegTensor<int32_t>ix;R::RegTensor<bfloat16_t>ab,bb,cb,sb,u0,v0;R::RegTensor<float>a,b,c,s,ac,bs,bc,as,u,v;
 R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(ab,y);R::Arange(ix,4);R::Gather(bb,y,(R::RegTensor<uint16_t>&)ix,p);
 R::Arange(ix,off);R::Gather(cb,cs,(R::RegTensor<uint16_t>&)ix,p);R::Arange(ix,off+half);R::Gather(sb,cs,(R::RegTensor<uint16_t>&)ix,p);
 R::Cast<float,bfloat16_t,up>(a,ab,p);R::Cast<float,bfloat16_t,up>(b,bb,p);R::Cast<float,bfloat16_t,up>(c,cb,p);R::Cast<float,bfloat16_t,up>(s,sb,p);
 R::Mul(ac,a,c,p);R::Mul(bs,b,s,p);R::Mul(bc,b,c,p);R::Mul(as,a,s,p);R::Sub(u,ac,bs,p);R::Add(v,bc,as,p);R::Cast<bfloat16_t,float,down>(u0,u,p);R::Cast<bfloat16_t,float,down>(v0,v,p);
 R::StoreAlign<bfloat16_t,R::StoreDist::DIST_PACK_B32>(y,u0,p);R::StoreAlign<bfloat16_t,R::StoreDist::DIST_PACK_B32>(y+16,v0,p);
}
__aicore__ inline void store_piece(LocalTensor<bfloat16_t>y,GlobalTensor<bfloat16_t>q,GlobalTensor<bfloat16_t>k,GlobalTensor<bfloat16_t>v,GlobalTensor<bfloat16_t>kc,GlobalTensor<bfloat16_t>vc,GlobalTensor<bfloat16_t>nk,GlobalTensor<bfloat16_t>nv,int h,int off,int len,int64_t slot,int wnz){
 DataCopyExtParams cp{1,(uint32_t)(len*2),0,0,0};
 if(h<16){DataCopyPad(q[h*256+off],y,cp);return;}
 int kh=h<20?h-16:h-20;if(h<20)DataCopyPad(k[kh*256+off],y,cp);else DataCopyPad(v[kh*256+off],y,cp);
 if(slot>=0){if(h<20)DataCopyPad(kc[slot*1024+kh*256+off],y,cp);else DataCopyPad(vc[slot*1024+kh*256+off],y,cp);
  if(wnz){int64_t noff=(slot/128)*128*1024+kh*128*256+(off/16)*128*16+(slot%128)*16+(off%16);if(h<20)DataCopyPad(nk[noff],y,cp);else DataCopyPad(nv[noff],y,cp);}
 }
}
__aicore__ inline void run(TPipe &pipe,GM_ADDR xgm,GM_ADDR wgm,GM_ADDR pgm,GM_ADDR cgm,GM_ADDR slgm,GM_ADDR qgm,GM_ADDR kgm,GM_ADDR vgm,GM_ADDR ggm,GM_ADDR kcgm,GM_ADDR vcgm,GM_ADDR nkgm,GM_ADDR nvgm,int rd,int write,int slot32,int wnz){
 constexpr int K=2560,M=8,N=6144;
 TQue<QuePosition::VECIN,2>wq;TQue<QuePosition::VECOUT,2>yq;TBuf<QuePosition::VECCALC>xb,tb,cb;
 pipe.InitBuffer(wq,2,M*K*2);pipe.InitBuffer(yq,2,64);pipe.InitBuffer(xb,K*6);pipe.InitBuffer(tb,M*256);pipe.InitBuffer(cb,512);
 auto x=xb.Get<bfloat16_t>();auto xf=xb.Get<float>()[K/2];auto tmp=tb.Get<float>();auto cs=cb.Get<bfloat16_t>();GlobalTensor<bfloat16_t>a,w,c,q,k,v,g,kc,vc,nk,nv;
 a.SetGlobalBuffer((__gm__ bfloat16_t*)xgm);w.SetGlobalBuffer((__gm__ bfloat16_t*)wgm);w.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);c.SetGlobalBuffer((__gm__ bfloat16_t*)cgm);q.SetGlobalBuffer((__gm__ bfloat16_t*)qgm);k.SetGlobalBuffer((__gm__ bfloat16_t*)kgm);v.SetGlobalBuffer((__gm__ bfloat16_t*)vgm);g.SetGlobalBuffer((__gm__ bfloat16_t*)ggm);kc.SetGlobalBuffer((__gm__ bfloat16_t*)kcgm);vc.SetGlobalBuffer((__gm__ bfloat16_t*)vcgm);nk.SetGlobalBuffer((__gm__ bfloat16_t*)nkgm);nv.SetGlobalBuffer((__gm__ bfloat16_t*)nvgm);
 GlobalTensor<int64_t>pos,sl64;GlobalTensor<int32_t>sl32;pos.SetGlobalBuffer((__gm__ int64_t*)pgm);sl64.SetGlobalBuffer((__gm__ int64_t*)slgm);sl32.SetGlobalBuffer((__gm__ int32_t*)slgm);int64_t slot=-1;if(write)slot=slot32?(int64_t)sl32.GetValue(0):sl64.GetValue(0);
 DataCopy(x,a,K);DataCopy(cs,c[pos.GetValue(0)*rd],rd);SetFlag<HardEvent::MTE2_V>(0);WaitFlag<HardEvent::MTE2_V>(0);
 expand_input((__ubuf__ bfloat16_t*)x.GetPhyAddr(),(__ubuf__ float*)xf.GetPhyAddr(),K);
 int core=GetBlockIdx(),start=core*M,stride=56*M;auto first=wq.AllocTensor<bfloat16_t>();DataCopy(first,w[(int64_t)start*K],M*K);wq.EnQue(first);
 for(int row=start;row<N;row+=stride){
  if(row+stride<N){auto next=wq.AllocTensor<bfloat16_t>();DataCopy(next,w[(int64_t)(row+stride)*K],M*K);wq.EnQue(next);}
  auto wt=wq.DeQue<bfloat16_t>();auto y=yq.AllocTensor<bfloat16_t>();gemv<K,M>((__ubuf__ float*)xf.GetPhyAddr(),(__ubuf__ bfloat16_t*)wt.GetPhyAddr(),(__ubuf__ float*)tmp.GetPhyAddr(),(__ubuf__ bfloat16_t*)y.GetPhyAddr());
  yq.EnQue(y);y=yq.DeQue<bfloat16_t>();int h=row/256,off=row%256;
  if(h<20&&off<rd){int firstoff=off/2;rope4((__ubuf__ bfloat16_t*)y.GetPhyAddr(),(__ubuf__ bfloat16_t*)cs.GetPhyAddr(),firstoff,rd/2);SetFlag<HardEvent::V_MTE3>(1);WaitFlag<HardEvent::V_MTE3>(1);store_piece(y,q,k,v,kc,vc,nk,nv,h,firstoff,4,slot,wnz);store_piece(y[16],q,k,v,kc,vc,nk,nv,h,firstoff+rd/2,4,slot,wnz);}
  else store_piece(y,q,k,v,kc,vc,nk,nv,h,off,8,slot,wnz);
  yq.FreeTensor(y);wq.FreeTensor(wt);
 }
 if(core<16){auto wt=wq.AllocTensor<bfloat16_t>();DataCopy(wt,w[(int64_t)(6144+core)*K],K);wq.EnQue(wt);wt=wq.DeQue<bfloat16_t>();auto y=yq.AllocTensor<bfloat16_t>();gemv<K,1>((__ubuf__ float*)xf.GetPhyAddr(),(__ubuf__ bfloat16_t*)wt.GetPhyAddr(),(__ubuf__ float*)tmp.GetPhyAddr(),(__ubuf__ bfloat16_t*)y.GetPhyAddr());yq.EnQue(y);y=yq.DeQue<bfloat16_t>();DataCopyExtParams cp{1,2,0,0,0};DataCopyPad(g[core],y,cp);yq.FreeTensor(y);wq.FreeTensor(wt);}
}

}
namespace MergeStage {
using namespace AscendC;
namespace R=AscendC::Reg;
constexpr R::CastTrait up{R::RegLayout::ZERO,R::SatMode::UNKNOWN,R::MaskMergeMode::ZEROING,RoundMode::UNKNOWN};
constexpr R::CastTrait down{R::RegLayout::ZERO,R::SatMode::NO_SAT,R::MaskMergeMode::ZEROING,RoundMode::CAST_RINT};
__simd_vf__ void gather_lse(__ubuf__ float*src,__ubuf__ float*out,int head,int length,int width){
 uint32_t count=8;auto p=R::UpdateMask<float>(count);R::RegTensor<int32_t>ix,start;R::RegTensor<float>z,neg;R::MaskReg valid;
 R::Arange(ix,0);R::Muls(start,ix,width,p);R::CompareScalar<int32_t,CMPMODE::LT>(valid,start,length,p);
 R::Muls(ix,ix,64,p);R::Adds(ix,ix,(head/2)*8+head%2,p);R::Gather(z,src,(R::RegTensor<uint32_t>&)ix,p);R::Duplicate(neg,-1.0e30f);R::Select(z,z,neg,valid);R::StoreAlign(out,z,p);
 R::LocalMemBar<R::MemType::VEC_STORE,R::MemType::VEC_LOAD>();
}
__simd_vf__ void merge8(__ubuf__ bfloat16_t*x,__ubuf__ float*w,__ubuf__ bfloat16_t*g,__ubuf__ bfloat16_t*y){
 uint32_t count=8;auto p8=R::UpdateMask<float>(count);auto p=R::CreateMask<float,R::MaskPattern::ALL>();
 R::RegTensor<float>z,m,s;R::LoadAlign(z,w);R::Reduce<R::ReduceType::MAX>(m,z,p8);R::Duplicate(m,m,p8);R::Sub(z,z,m,p8);R::Exp(z,z,p8);R::Reduce<R::ReduceType::SUM>(s,z,p8);R::Duplicate(s,s,p8);R::Div(z,z,s,p8);R::StoreAlign(w,z,p8);
 R::LocalMemBar<R::MemType::VEC_STORE,R::MemType::VEC_LOAD>();
 R::RegTensor<bfloat16_t>gb;R::RegTensor<float>gf;R::LoadAlign<bfloat16_t,R::LoadDist::DIST_BRC_B16>(gb,g);R::Cast<float,bfloat16_t,up>(gf,gb,p);
 for(uint16_t j=0;j<4;j++){
  R::RegTensor<float>acc,a,b,tmp;R::RegTensor<bfloat16_t>ab,yb;R::Duplicate(acc,0.0f);
  for(uint16_t i=0;i<8;i++){R::LoadAlign<bfloat16_t,R::LoadDist::DIST_UNPACK_B16>(ab,x+i*256+j*64);R::Cast<float,bfloat16_t,up>(a,ab,p);R::LoadAlign<float,R::LoadDist::DIST_BRC_B32>(b,w+i);R::Mul(tmp,a,b,p);R::Add(acc,acc,tmp,p);}
  R::Cast<bfloat16_t,float,down>(yb,acc,p);R::Cast<float,bfloat16_t,up>(acc,yb,p);R::Mul(acc,acc,gf,p);R::Cast<bfloat16_t,float,down>(yb,acc,p);R::StoreAlign<bfloat16_t,R::StoreDist::DIST_PACK_B32>(y+j*64,yb,p);
 }
}
__aicore__ inline void run(TPipe &pipe,GM_ADDR xgm,GM_ADDR lgm,GM_ADDR pgm,GM_ADDR ggm,GM_ADDR lutgm,GM_ADDR ygm,int32_t width){
 TBuf<QuePosition::VECCALC>xb,wb,yb,gb,lb,sb;pipe.InitBuffer(xb,4096);pipe.InitBuffer(wb,256);pipe.InitBuffer(yb,512);pipe.InitBuffer(gb,128);pipe.InitBuffer(sb,8704);pipe.InitBuffer(lb,2048);
 auto x=xb.Get<bfloat16_t>();auto w=wb.Get<float>();auto y=yb.Get<bfloat16_t>();GlobalTensor<bfloat16_t>src,out;GlobalTensor<float>l;GlobalTensor<int64_t>pos;
 src.SetGlobalBuffer((__gm__ bfloat16_t*)xgm);out.SetGlobalBuffer((__gm__ bfloat16_t*)ygm);l.SetGlobalBuffer((__gm__ float*)lgm);pos.SetGlobalBuffer((__gm__ int64_t*)pgm);
 auto g=gb.Get<uint16_t>();GlobalTensor<uint16_t>gate,lut;gate.SetGlobalBuffer((__gm__ uint16_t*)ggm);lut.SetGlobalBuffer((__gm__ uint16_t*)lutgm);int h=GetBlockIdx();DataCopy(g,gate,16);int64_t p=pos.GetValue(0);
 auto sigmoid=sb.Get<uint16_t>();DataCopy(sigmoid,lut[0x3b00],2048);DataCopy(sigmoid[2048],lut[0xbb00],2048);DataCopy(sigmoid[4096],lut[0x7f80],128);DataCopy(sigmoid[4224],lut[0xff80],128);
 auto lv=lb.Get<float>();DataCopy(lv,l,512);
 SetFlag<HardEvent::MTE2_V>(2);WaitFlag<HardEvent::MTE2_V>(2);
 gather_lse((__ubuf__ float*)lv.GetPhyAddr(),(__ubuf__ float*)w.GetPhyAddr(),h,(int)p+1,width);
 SigmoidLookup::run((__ubuf__ uint16_t*)g.GetPhyAddr(),(__ubuf__ uint16_t*)sigmoid.GetPhyAddr(),(__ubuf__ uint16_t*)g.GetPhyAddr(),16);
 DataCopyExtParams cp{8,512,7680,0,0};DataCopyPad(x,src[h*256],cp,DataCopyPadExtParams<bfloat16_t>{false,0,0,0});
