 init((__ubuf__ float*)state.GetPhyAddr(),(__ubuf__ float*)out.GetPhyAddr());
 if(valid>0){CrossCoreSetFlag<4,PIPE_V>(0);CrossCoreSetFlag<4,PIPE_V>(3);CrossCoreSetFlag<4,PIPE_V>(2);}
 for(int step=-1;step<(valid+N-1)/N;step++){
  if((step+1)*N<valid){int off=(step+1)*N,slot=(step+1)%2,qflag=slot?3:0,pflag=slot?4:1;
