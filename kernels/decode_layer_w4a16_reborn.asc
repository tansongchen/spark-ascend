#include "w4a16_reborn_linear.h"
#include "w4a16_reborn_post.h"
#include "w4a16_reborn_attention.h"
#include "w4a16_reborn_kv8.h"
#include "w4a16_reborn_full8.h"
using namespace AscendC;

extern "C" __global__ __aicore__ void reborn_kv8_codec(GM_ADDR src,GM_ADDR dst,int count,int mode) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;TBuf<TPosition::VECCALC> bb,qb;
    pipe.InitBuffer(bb,8192);pipe.InitBuffer(qb,4096);
    auto b=bb.Get<bfloat16_t>();auto q=qb.Get<uint8_t>();
    GlobalTensor<bfloat16_t> bg;GlobalTensor<uint8_t> qg;
    bg.SetGlobalBuffer((__gm__ bfloat16_t*)(mode?dst:src));qg.SetGlobalBuffer((__gm__ uint8_t*)(mode?src:dst));
    for(int first=GetBlockIdx()*4096;first<count;first+=GetBlockNum()*4096) {
        int n=count-first<4096?count-first:4096;
        if(mode)DataCopy(q,qg[first],n);else DataCopy(b,bg[first],n);
        SetFlag<HardEvent::MTE2_V>(0);WaitFlag<HardEvent::MTE2_V>(0);
        if(mode)Kv8::Decode((__ubuf__ uint8_t*)q.GetPhyAddr(),(__ubuf__ bfloat16_t*)b.GetPhyAddr(),n);
        else Kv8::Encode((__ubuf__ bfloat16_t*)b.GetPhyAddr(),(__ubuf__ uint8_t*)q.GetPhyAddr(),n);
        SetFlag<HardEvent::V_MTE3>(0);WaitFlag<HardEvent::V_MTE3>(0);
        if(mode)DataCopy(bg[first],b,n);else DataCopy(qg[first],q,n);
        SetFlag<HardEvent::MTE3_V>(0);WaitFlag<HardEvent::MTE3_V>(0);
        SetFlag<HardEvent::V_MTE2>(0);WaitFlag<HardEvent::V_MTE2>(0);
    }
}
extern "C" void launch_reborn_kv8_codec(void* stream,void* src,void* dst,int count,int mode) {
    reborn_kv8_codec<<<56,nullptr,stream>>>((uint8_t*)src,(uint8_t*)dst,count,mode);
}

extern "C" __global__ __aicore__ void w4a16_reborn_linear(
    GM_ADDR x, GM_ADDR w, GM_ADDR partial, int n, int kind) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    if(kind==0) Reborn::Linear<2560,10>(pipe,x,w,partial,n,GetBlockNum());
    else if(kind==1) Reborn::Linear<4096,8>(pipe,x,w,partial,n,GetBlockNum());
    else Reborn::Linear<10240,10>(pipe,x,w,partial,n,GetBlockNum());
}

extern "C" void launch_w4a16_reborn_linear(void* stream,void* x,void* w,
    void* partial,int n,int kind,int cores) {
    w4a16_reborn_linear<<<cores,nullptr,stream>>>((uint8_t*)x,(uint8_t*)w,
        (uint8_t*)partial,n,kind);
}

extern "C" __global__ __aicore__ void w4a16_reborn_head_merge(GM_ADDR partial,GM_ADDR out,int n) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;TBuf<TPosition::VECCALC> pb,yb;pipe.InitBuffer(pb,1024);pipe.InitBuffer(yb,256);
    auto p=pb.Get<float>();auto y=yb.Get<bfloat16_t>();
    GlobalTensor<float> pg;GlobalTensor<bfloat16_t> yg;
    pg.SetGlobalBuffer((__gm__ float*)partial);yg.SetGlobalBuffer((__gm__ bfloat16_t*)out);
    for(int tile=GetBlockIdx();tile<n/128;tile+=GetBlockNum()) {
        DataCopy(p,pg[tile*256],256);
        SetFlag<HardEvent::MTE2_V>(0);WaitFlag<HardEvent::MTE2_V>(0);
        Reborn::MergeLinear<2,1>((__ubuf__ float*)p.GetPhyAddr(),(__ubuf__ bfloat16_t*)y.GetPhyAddr());
        SetFlag<HardEvent::V_MTE3>(0);WaitFlag<HardEvent::V_MTE3>(0);DataCopy(yg[tile*128],y,128);
        SetFlag<HardEvent::V_MTE2>(0);WaitFlag<HardEvent::V_MTE2>(0);
        SetFlag<HardEvent::MTE3_V>(0);WaitFlag<HardEvent::MTE3_V>(0);
    }
}
extern "C" void launch_w4a16_reborn_head(void* stream,void* x,void* w,void* partial,void* y,int n) {
    w4a16_reborn_linear<<<56,nullptr,stream>>>((uint8_t*)x,(uint8_t*)w,(uint8_t*)partial,n,0);
    w4a16_reborn_head_merge<<<56,nullptr,stream>>>((uint8_t*)partial,(uint8_t*)y,n);
}

extern "C" __global__ __aicore__ void decode_layer_w4a16_reborn(
 GM_ADDR x,GM_ADDR res,GM_ADDR wq,GM_ADDR wo,GM_ADDR w1,GM_ADDR w2,GM_ADDR g1,GM_ADDR g2,
 GM_ADDR pos,GM_ADDR cs,GM_ADDR slots,GM_ADDR table,GM_ADDR kc,GM_ADDR vc,GM_ADDR nk,GM_ADDR nv,
 GM_ADDR ws,GM_ADDR y,GM_ADDR resout,int rd,int slot32,float e1,float e2) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2); InitSocState();
    int width=rd==64?5120:128;
#ifdef __DAV_C310_CUBE__
    CrossCoreWaitFlag<4,PIPE_MTE2>(7);CrossCoreWaitFlag<4,PIPE_MTE2>(23);
    for(int logical=GetBlockIdx();logical<32;logical+=28) {
        if(rd==64) Full8::cube(ws,pos,width,logical);
        else SwaStage::cube(ws,kc,vc,table,pos,width,logical);
        PipeBarrier<PIPE_ALL>();
    }
#else
    TPipe pipe;
    Reborn::Linear<2560,10>(pipe,x,wq,ws+Reborn::Scratch,6144,56);
    Reborn::Barrier(pipe);
    Reborn::QkvPost(pipe,x,wq,pos,cs,slots,kc,vc,nk,nv,ws,rd,slot32);
    // The following signal is issued on MTE3: a wait confined to MTE2
    // would not order it after all Q/K/V producers across the vector cores.
    SyncAll<true>();pipe.Reset();CrossCoreSetFlag<4,PIPE_MTE3>(7);
    for(int logical=GetBlockIdx();logical<64;logical+=56) {
        if(rd==64) Full8::vec(pipe,nk,nv,table,pos,ws+12544,ws+78080,width,logical);
        else SwaStage::vec(pipe,pos,ws+12544,ws+78080,width,logical);
        PipeBarrier<PIPE_ALL>();pipe.Reset();
    }
    SyncAll<true>();pipe.Reset();
    Reborn::MergeAttention(pipe,ws);
    Reborn::Barrier(pipe);
    Reborn::Linear<4096,8>(pipe,ws+80128,wo,ws+Reborn::Scratch,2560,56);
    Reborn::Barrier(pipe);
    Reborn::Norm<4>(pipe,ws+Reborn::Scratch,res,g1,ws+88320,ws+Reborn::NormInput,ws+119040,e1);
    Reborn::Barrier(pipe);
    Reborn::Linear<2560,10>(pipe,ws+Reborn::NormInput,w1,ws+Reborn::Scratch,20480,56);
    Reborn::Barrier(pipe);
    Reborn::UpPost(pipe,ws);
    Reborn::Barrier(pipe);
    Reborn::Linear<10240,10>(pipe,ws+93440,w2,ws+Reborn::Scratch,2560,56);
    Reborn::Barrier(pipe);
    Reborn::Norm<8>(pipe,ws+Reborn::Scratch,ws+119040,g2,ws+113920,y,resout,e2);
#endif
}

extern "C" void launch_decode_layer_w4a16(void* stream,uint8_t** a,uint8_t* kc,uint8_t* vc,
 uint8_t* nk,uint8_t* nv,uint8_t* ws,uint8_t* y,uint8_t* resout,int rd,int slot32,float e1,float e2) {
    decode_layer_w4a16_reborn<<<28,nullptr,stream>>>(a[0],a[1],a[2],a[3],a[4],a[5],a[8],a[9],
        a[10],a[11],a[12],a[13],kc,vc,nk,nv,ws,y,resout,rd,slot32,e1,e2);
}
