#include "kernel_operator.h"
using namespace AscendC;
extern "C" __global__ __aicore__ void stream_read(GM_ADDR src,GM_ADDR sampled,uint32_t total,uint32_t tile){
 KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
 TPipe pipe;
 TQueBind<TPosition::VECIN,TPosition::VECOUT,1> q;
 pipe.InitBuffer(q,1,tile*sizeof(uint32_t));
 GlobalTensor<uint32_t> input,output;
 input.SetGlobalBuffer((__gm__ uint32_t*)src,total);
 input.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);
 output.SetGlobalBuffer((__gm__ uint32_t*)sampled);
 for(uint32_t i=GetBlockIdx();i<total/tile;i+=GetBlockNum()){
  auto local=q.AllocTensor<uint32_t>();
  DataCopy(local,input[(uint64_t)i*tile],tile);
  q.EnQue(local);local=q.DeQue<uint32_t>();
  // Observable 32-byte sample of each DMA tile, hashed/verified by the host.
  // The full input DataCopy remains an explicit MTE2 transfer. Output traffic is <= 0.2%.
  DataCopy(output[(uint64_t)i*8],local,8);
  q.FreeTensor(local);
 }
}
#ifndef __CCE_AICORE__
extern "C" void launch_stream_read(void*s,uint8_t*x,uint8_t*y,uint32_t cores,uint32_t total,uint32_t tile){
 stream_read<<<cores,nullptr,s>>>(x,y,total,tile);
}
#endif
