// Minimal reproducer, independent of model weights and Python.
#include "kernel_operator.h"
using namespace AscendC;
extern "C" __global__ __aicore__ void validation_sync_probe(GM_ADDR out) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    InitSocState();
#ifndef __DAV_C310_CUBE__
    GlobalTensor<float> result;
    result.SetGlobalBuffer((__gm__ float*)out);
    result.SetValue(GetBlockIdx(), 17.0f);
    SyncAll<true>();
#endif
}
extern "C" void launch_validation_sync_probe(void* stream, uint8_t* out) {
    validation_sync_probe<<<28, nullptr, stream>>>(out);
}
