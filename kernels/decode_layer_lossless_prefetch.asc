template<int K,int M> __aicore__ inline int linear_stage(TPipe &pipe,GM_ADDR xgm,GM_ADDR wgm,GM_ADDR ygm,int32_t N,int logical,int first_slot=0,bool prefetched=false,GM_ADDR next_wgm=nullptr){

 TBuf<QuePosition::VECCALC>weights,yb,xb,tb,decoded;
 pipe.InitBuffer(weights,131072);pipe.InitBuffer(decoded,81920);pipe.InitBuffer(yb,((N+56*M-1)/(56*M))*32);pipe.InitBuffer(xb,K==10240?K*2:K*6);pipe.InitBuffer(tb,M*256);
